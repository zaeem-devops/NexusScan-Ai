# ===== NexusScan AI Configuration =====
# Copy this file to .env and fill in your values.

# Server port
PORT=3000

# MongoDB connection string (server falls back to Hybrid Memory Mode if unreachable)
MONGO_URI=mongodb://127.0.0.1:27017/nexusScanAI

# WhatsApp number that receives threat alerts & attendance notifications (Pakistan format)
SECURITY_PHONE=03XXXXXXXXX

# Faculty/admin password for the Faculty View login
ADMIN_PASSWORD=admin123

# Comma-separated WhatsApp numbers allowed to send LOCK / UNLOCK / STATUS / ANNOUNCE.
# Example: ADMIN_WHITELIST=923001234567,923007654321
# WARNING: leave empty ONLY for demo — otherwise anyone can lock your system.
ADMIN_WHITELIST=

# Optional: custom Chrome/Chromium path for whatsapp-web.js (Puppeteer)
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# ===== Gemini AI Assistant (OPTIONAL but RECOMMENDED for hackathon) =====
# Get your FREE API key from: https://aistudio.google.com/app/apikey
# Without this key, NexusScan uses Smart Local AI fallback (still works!)
# With this key, the AI Assistant upgrades to full Google Gemini LLM
# GEMINI_API_KEY=your_gemini_api_key_goes_here
